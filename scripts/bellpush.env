BELLPUSH=pibell-1:8080
APPINSIGHTS_INSTRUMENTATIONKEY=
# WEBHOOK_URL=http://dash-api-go:8080/push/notify
# Whether motion detected/stopped events also fire the webhook (button-press
# events always fire regardless of this setting). Defaults to true.
# WEBHOOK_MOTION_ENABLE=true
# GO2RTC_URL=http://localhost:1984
# GO2RTC_PUBLIC_URL=http://<pi-hostname-or-ip>:1984
# GO2RTC_STREAM=doorbell

# ONVIF Events (PullPoint) support for UniFi Protect motion recording.
# Defaults to enabled whenever GO2RTC_URL is set above; set to "false" to
# disable (e.g. if Protect should adopt go2rtc directly, video-only).
# ONVIF_ENABLE=true
# Which motion topic to advertise/emit: "cell" or "alarm" - see README.md
# ("ONVIF motion -> UniFi Protect recording") for details. Flip this if
# motion clips aren't appearing on the Protect timeline.
# "alarm" seems to be the option that works 
# ONVIF_MOTION_TOPIC=alarm